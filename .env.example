# ==============================================================================
# CHECKPOINT TECHNICAL - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Server Network & Runtime Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=Daviteq_Checkpoint_Technical_Key_2026_Secure!

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=checkpoint_technical
DB_SSL=false
DB_AUTO_INIT=true

# Alternative Postgres Standard Environment Variables (also supported)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=checkpoint_technical

# Local Storage Directory (Used for file backups or when PostgreSQL is unreachable)
DATA_DIR=./data
