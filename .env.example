# ==============================================================================
# CHECKPOINT TECHNICAL - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Server Network & Runtime Configuration
PORT=3001
NODE_ENV=production
JWT_SECRET=Daviteq_Checkpoint_Technical_Key_2026_Secure!

# PostgreSQL Database Configuration (Kết nối container PostgreSQL có sẵn)
# Chạy local dev: DB_HOST=localhost
# Chạy Docker Compose cùng network internal_net: DB_HOST=postgres (hoặc iot_postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=mason
DB_NAME=checkpoint_technical
DB_SSL=false
DB_AUTO_INIT=true

# Alternative Postgres Standard Environment Variables (Đồng bộ với Docker Stack PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=mason
POSTGRES_DB=checkpoint_technical

# Local Storage Directory (Used for file backups or when PostgreSQL is unreachable)
DATA_DIR=./data
