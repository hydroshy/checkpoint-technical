# ==============================================================================
# CHECKPOINT SYSTEMS — CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# ==============================================================================
# Bản mẫu cấu hình toàn diện biến môi trường cho ứng dụng Checkpoint Technical.
# Khi triển khai thực tế (Production / Docker):
# 1. Sao chép tệp này thành .env: cp .env.example .env
# 2. Điều chỉnh các thông số kết nối PostgreSQL và đổi JWT_SECRET bảo mật.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH MẠNG & RUNTIME CỦA ỨNG DỤNG (SERVER NETWORK & RUNTIME)
# ------------------------------------------------------------------------------
# Cổng lắng nghe của NestJS HTTP Web Server (mặc định: 3001)
PORT=3001

# Môi trường chạy ứng dụng: production | development | test
NODE_ENV=production

# Khóa bí mật ký xác thực JWT Token (Bắt buộc đổi trong môi trường production!)
# Khuyến nghị chuỗi ngẫu nhiên bảo mật cao tối thiểu 32 ký tự.
# Lệnh tạo khóa ngẫu nhiên trên Linux/macOS: openssl rand -base64 32
JWT_SECRET=Checkpoint_Systems_Technical_Key_2026_Secure!

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH KẾT NỐI POSTGRESQL CHUẨN CHÍNH THỨC (PRIMARY DB_* VARIABLES)
# ------------------------------------------------------------------------------
# Địa chỉ IP hoặc hostname máy chủ PostgreSQL:
# - Triển khai mạng nội bộ (Host): 192.168.1.35
# - Triển khai Docker Compose (Container): postgres_db (hoặc 192.168.1.35)
# - Chạy thử nghiệm máy cá nhân: localhost hoặc 127.0.0.1
DB_HOST=192.168.1.35

# Cổng dịch vụ PostgreSQL (chuẩn: 5432)
DB_PORT=5432

# Tài khoản đăng nhập cơ sở dữ liệu
DB_USERNAME=admin

# Mật khẩu tài khoản PostgreSQL (Đổi mật khẩu mạnh khi chạy production!)
DB_PASSWORD=Ph@nloi20031403

# Tên cơ sở dữ liệu đích
DB_NAME=checkpoint_technical

# Tự động khởi tạo Schema & 14 bảng dữ liệu khi khởi động lần đầu (true / false)
# Khuyến nghị: true (giúp hệ thống tự động sinh bảng và nạp seed dữ liệu mẫu)
DB_AUTO_INIT=true

# Kết nối SSL với PostgreSQL (true / false)
DB_SSL=false

# ------------------------------------------------------------------------------
# 3. BIẾN MÔI TRƯỜNG TƯƠNG THÍCH (POSTGRES_* & YAML ALIASES)
# Hệ thống EnvValidator tự động nhận diện và phân giải nếu các biến DB_* ở trên vắng mặt.
# ------------------------------------------------------------------------------
POSTGRES_HOST=192.168.1.35
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=Ph@nloi20031403
POSTGRES_DB=checkpoint_technical

# Aliases ngắn gọn bổ sung
DB_USER=admin
DB_DATABASE=checkpoint_technical
USER=admin
PASSWORD=Ph@nloi20031403
DB=checkpoint_technical

# ------------------------------------------------------------------------------
# 4. LƯU TRỮ CỤC BỘ DỰ PHÒNG (LOCAL PERSISTENCE / HYBRID FALLBACK)
# ------------------------------------------------------------------------------
# Thư mục lưu trữ file JSON dự phòng khi máy chủ PostgreSQL tạm thời mất kết nối.
# - Môi trường Local / Dev: ./data
# - Môi trường Docker Container: /app/data
DATA_DIR=./data
