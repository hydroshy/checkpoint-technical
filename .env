# ==============================================================================
# CHECKPOINT TECHNICAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network & Runtime Configuration
PORT=3001
NODE_ENV=production
JWT_SECRET=Checkpoint_Systems_Technical_Key_2026_Secure!

# PostgreSQL Server Connection Variables (Kết nối container PostgreSQL có sẵn)
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=mason
POSTGRES_DB=checkpoint_technical
DB_AUTO_INIT=true

# Compatible DB_* environment variables (auto-derived if omitted)
DB_HOST=postgres_db
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=mason
DB_NAME=checkpoint_technical

# Local Storage Directory (Used for file backups or when PostgreSQL is unreachable)
DATA_DIR=./data
